[Unit]
Description=Neoracer Wall Follow Dashboard (port 8081)
After=neoracer-teleop.service

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/bin/bash -c '\
    source /opt/ros/humble/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    exec python3 /home/racecar/wallfollow/wallfollow.py'
Restart=on-failure
RestartSec=5
Environment=HOME=/home/racecar
WorkingDirectory=/home/racecar/wallfollow

[Install]
WantedBy=multi-user.target
